# ASVILLA Hotel Booking & Reservation Platform — Environment Configuration Template
PORT=3000
NODE_ENV=development

# MongoDB Atlas Database Configuration
# Read by backend/config/db.js and backend/config/db.ts
# Database name will be set to asvilla_hotel_booking
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGO_DB_NAME=asvilla_hotel_booking

# Application & Client URLs
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Razorpay Payment Gateway (India)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
